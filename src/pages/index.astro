---
import Base from '../layouts/Base.astro';
import Decor from '../components/Decor.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';


// Version de la vidéo du hero : à augmenter à chaque nouvelle vidéo pour que les navigateurs
// ne gardent pas l'ancienne en mémoire.
const heroV = '6';

// Morceaux à écouter — éditables depuis /admin (collection « musique »).
const extraits = (await getCollection('musique'))
  .map((e) => ({ titre: e.data.titre, src: e.data.fichier }))
  .sort((a, b) => a.titre.localeCompare(b.titre, 'fr'));
// Agenda : depuis /admin. (Pour l'instant toutes les dates sont affichées, même passées.)
const MOIS = ['JANV', 'FÉVR', 'MARS', 'AVR', 'MAI', 'JUIN', 'JUIL', 'AOÛT', 'SEPT', 'OCT', 'NOV', 'DÉC'];
const JOURS = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
const agenda = (await getCollection('agenda'))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4)
  .map((e) => {
    const d = e.data.date;
    return {
      iso: d.toISOString().slice(0, 10),
      j: String(d.getUTCDate()).padStart(2, '0'), m: MOIS[d.getUTCMonth()],
      quand: e.data.heure ? `${JOURS[d.getUTCDay()]} · ${e.data.heure}` : JOURS[d.getUTCDay()],
      lieu: e.data.lieu, ville: e.data.ville, info: e.data.info,
    };
  });
const prestations = [
  { n: '01', ico: 'glass', titre: 'Restaurants & bars', txt: "On passe entre les tables et on chante, sans couvrir les conversations. Vos clients restent, et ils reviennent." },
  { n: '02', ico: 'building', titre: "Événements d'entreprise", txt: "Séminaires, inaugurations, soirées clients. Un moment qui change des discours et fait chanter les équipes." },
  { n: '03', ico: 'bunting', titre: 'Fêtes locales & maritimes', txt: "Fêtes de la musique, courses à la voile, 14 juillet. Sur scène, avec le répertoire qui fait lever la foule." },
];
// Galerie — éditable depuis /admin (collection « galerie »).
const galerie = (await getCollection('galerie'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((e) => ({ src: e.data.image, alt: e.data.legende || 'Les Flambarts en concert' }));
---
<Base active="accueil">

  <!-- ============ HERO (scène animée) ============ -->
  <section class="hero">
    <div class="hero-scene" aria-hidden="true">
      <!-- Vidéo en arrière-plan, texte par-dessus (ordinateur comme téléphone).
           Ordinateur : image entière (musiciens à droite). Téléphone : recadrage sur les musiciens, fichier plus léger. -->
      <video class="hero-video" autoplay muted loop playsinline webkit-playsinline preload="auto" poster={`/hero-poster.jpg?v=${heroV}`}>
        <source src={`/hero.webm?v=${heroV}`} type="video/webm" media="(min-width: 861px)" />
        <source src={`/hero.mp4?v=${heroV}`} type="video/mp4" media="(min-width: 861px)" />
        <source src={`/hero-mobile.webm?v=${heroV}`} type="video/webm" />
        <source src={`/hero-mobile.mp4?v=${heroV}`} type="video/mp4" />
      </video>
    </div>

    <div class="wrap hero-in">
      <div class="hero-copy">
        <span class="kicker">7 musiciens · Herbignac, presqu'île guérandaise (44)</span>
        <h1 class="h-display">Chants marins pour vos fêtes <span class="amp">&amp;</span> événements</h1>
        <p class="lead">
          Mariages, fêtes de village, restaurants, soirées d'entreprise : on reprend les grands chants
          de marins, de « Santiano » à « Nous irons à Valparaiso », et toute la salle finit par chanter avec nous.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/contact">Faire jouer les Flambarts</a>
          <a class="btn btn-ghost" href="#extraits">▶ Nous écouter</a>
        </div>
        <p class="hero-proof">Déjà sur scène au <strong>Festival Voix Marines</strong></p>
      </div>
    </div>

    <div class="hero-badge"><strong>7</strong><span>musiciens · Herbignac (44)</span></div>
  </section>

  <div class="rule-wave" aria-hidden="true"></div>

  <!-- ============ LES FLAMBARTS EN 35 SECONDES (vidéo de présentation) ============ -->
  <section class="pad-sm presentation has-decor" id="presentation">
    <Decor name="guitare" side="right" top="56%" size={340} rot={18} out={56} />
    <div class="wrap pres-grid">
      <div class="pres-copy">
        <span class="kicker">En 35 secondes</span>
        <h2 class="h-lg">Ce qu'on apporte à votre fête</h2>
        <p class="lead">
          Un groupe de chants marins qui fait chanter vos invités, du mariage à la soirée d'entreprise.
        </p>
        <ul class="pres-list">
          <li><span aria-hidden="true">1</span>Concerts de chants marins</li>
          <li><span aria-hidden="true">2</span>Animations déambulatoires</li>
          <li><span aria-hidden="true">3</span>Chants à reprendre en chœur</li>
        </ul>
        <a class="btn btn-primary" href="/contact">Nous contacter</a>
      </div>
      <figure class="pres-video">
        <video class="pres-player" muted loop playsinline webkit-playsinline preload="none"
          poster="/presentation-poster.jpg" aria-label="Vidéo de présentation des Flambarts">
          <source src="/presentation.webm" type="video/webm" />
          <source src="/presentation.mp4" type="video/mp4" />
        </video>
        <button class="pres-sound" type="button" aria-pressed="false">Activer le son</button>
      </figure>
    </div>
  </section>

  <!-- ============ GALERIE PHOTO ============ -->
  <section class="pad-sm gallery" id="galerie">
    <div class="wrap">
      <div class="section-head center">
        <span class="kicker">En images</span>
        <h2 class="h-lg">Le groupe en photos</h2>
        <p class="lead" style="margin:12px auto 0">
          Tournez la barre (ou faites défiler), puis cliquez sur une photo pour la voir en grand.
        </p>
      </div>
    </div>
    <div class="gal-carousel" role="region" aria-label="Photos des Flambarts">
      {galerie.map((p, i) => (
        <button class="gal-thumb" data-full={p.src} type="button" aria-label={`Agrandir la photo ${i + 1} sur ${galerie.length}`}>
          <img src={p.src} alt={p.alt} loading="lazy" width="600" height="600" />
        </button>
      ))}
    </div>
    <!-- Barre à roue : la tourner fait défiler les photos (30 % sur les photos, 70 % dessous) -->
    <div class="helm-wrap">
      <svg class="rope" aria-hidden="true"></svg>
      <div class="helm" role="slider" tabindex="0" aria-label="Barre à roue : tournez-la pour faire défiler les photos"
        aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="Début de la galerie">
        <svg class="helm-svg" viewBox="-110 -110 220 220" aria-hidden="true">
          <g class="helm-rot">
            <g transform="rotate(0)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(45)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(90)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(135)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(180)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(225)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(270)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <g transform="rotate(315)"><rect x="-5" y="-104" width="10" height="70" rx="4" fill="#B97A3D" stroke="#241A12" stroke-width="3"/><rect x="-8" y="-108" width="16" height="26" rx="8" fill="#D6A15E" stroke="#241A12" stroke-width="3"/></g>
            <circle r="66" fill="none" stroke="#241A12" stroke-width="20"/>
            <circle r="66" fill="none" stroke="#D6A15E" stroke-width="13"/>
            <circle r="66" fill="none" stroke="#A8763A" stroke-width="2" stroke-dasharray="6 9"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(0)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(0)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(45)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(45)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(90)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(90)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(135)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(135)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(180)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(180)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(225)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(225)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(270)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(270)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(315)" stroke="#241A12" stroke-width="9" stroke-linecap="round"/><line x1="0" y1="-24" x2="0" y2="-58" transform="rotate(315)" stroke="#B97A3D" stroke-width="5" stroke-linecap="round"/>
            <defs>
              <pattern id="corde-enroulee" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(-55)">
                <rect width="9" height="9" fill="#D6A15E"/><rect width="3" height="9" fill="#B97A3D"/><rect x="3" width="2" height="9" fill="#8A5A2B"/>
              </pattern>
            </defs>
            <circle r="36" fill="url(#corde-enroulee)" stroke="#241A12" stroke-width="3"/>
            <circle r="30" fill="none" stroke="#8A5A2B" stroke-width="1.5" opacity=".7"/>
            <circle r="24" fill="#C24E2C" stroke="#241A12" stroke-width="3.5"/>
            <circle r="9" fill="#FBF6EC" stroke="#241A12" stroke-width="3"/>
            <circle cx="0" cy="-92" r="4" fill="#C24E2C"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-close" type="button" aria-label="Fermer">✕</button>
    <button class="lb-prev" type="button" aria-label="Photo précédente">‹</button>
    <img class="lb-img" src="" alt="Les Flambarts en concert" />
    <button class="lb-next" type="button" aria-label="Photo suivante">›</button>
  </div>

  <!-- ============ EXTRAITS AUDIO ============ -->
  <section class="pad has-decor" id="extraits">
    <Decor name="micro" side="left" top="50%" size={280} rot={16} out={52} />
    <div class="wrap">
      <div class="section-head center">
        <span class="kicker">À écouter</span>
        <h2 class="h-lg">Notre musique</h2>
        <p class="lead" style="margin:12px auto 0">
          Quelques morceaux à écouter tout de suite. Montez le son.
        </p>
      </div>
      {extraits.length > 0 && (
        <div class="grid grid-2">
          {extraits.map((e) => (
            <div class="track">
              <div class="track-t serif">{e.titre}</div>
              <audio controls preload="none" src={e.src}></audio>
            </div>
          ))}
        </div>
      )}
      <p class="note">D'autres morceaux seront ajoutés au fil du temps.</p>
    </div>
  </section>

  <!-- ============ CONCEPT ============ -->
  <section class="pad concept">
    <div class="wrap grid grid-2 concept-in">
      <div>
        <span class="kicker">Le nom</span>
        <h2 class="h-lg" style="margin:14px 0 16px">D'où vient « Les Flambarts »</h2>
        <p class="lead" style="color:#d9e4ea">
          Un flambart, c'est une vieille chaloupe de pêche. Le mot sonne aussi comme la flamme
          et l'entrain, et ça nous va bien. On chante le répertoire des marins, ces refrains que
          le public reprend en chœur. On joue aussi bien entre les tables que sur une vraie scène,
          et on vient avec notre matériel.
        </p>
        <a class="btn btn-primary" style="margin-top:24px" href="/le-groupe">Rencontrer le groupe →</a>
      </div>
      <div class="card concept-card">
        <div class="flame"><Icon name="flame" size={38} /></div>
        <h3 class="serif" style="font-size:1.4rem;margin-bottom:10px">En un mot</h3>
        <p style="color:#cfe0e8">
          On joue pour de vrai, sans se prendre au sérieux. Le but tient en une phrase : que la
          salle chante avec nous et reparte de bonne humeur.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ AGENDA ============ -->
  <section class="pad has-decor" id="agenda">
    <Decor name="basse" side="right" top="62%" size={280} rot={24} out={62} />
    <div class="wrap">
      <div class="head-row">
        <div><span class="kicker">Agenda</span><h2 class="h-xl" style="margin-top:12px">Où nous voir bientôt</h2></div>
        <a class="btn btn-ghost" href="/actualites">Toutes les dates →</a>
      </div>
      <ul class="date-list" data-agenda>
        {agenda.map((d) => (
          <li class="date-row" data-date={d.iso}>
            <div class="date-badge"><strong>{d.j}</strong><span>{d.m}</span></div>
            <div class="date-main">
              <div class="date-when">{d.quand}</div>
              <div class="date-lieu serif">{d.lieu}</div>
              <div class="date-ville">{d.ville}</div>
            </div>
            {d.info && <span class="date-info">{d.info}</span>}
          </li>
        ))}
      </ul>
      <p class="agenda-vide" hidden={agenda.length > 0}>
        Prochaines dates bientôt annoncées. En attendant, suivez-nous sur
        <a href="https://www.facebook.com/p/Les-Flambarts-61557394624239/" target="_blank" rel="noopener">Facebook</a>,
        ou <a href="/contact">faites-nous jouer chez vous</a>.
      </p>
    </div>
  </section>

  <!-- ============ PRESTATIONS ============ -->
  <section class="pad prestations has-decor">
    <Decor name="accordeon" side="left" top="50%" size={400} rot={-10} out={66} />
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Nos prestations</span>
        <h2 class="h-xl" style="margin-top:14px">Ce qu'on fait</h2>
      </div>
      <ol class="presta-list">
        {prestations.map((p) => (
          <li class="presta-row">
            <span class="presta-n serif" aria-hidden="true">{p.n}</span>
            <div class="presta-ico"><Icon name={p.ico} /></div>
            <div class="presta-body">
              <h3 class="serif">{p.titre}</h3>
              <p>{p.txt}</p>
            </div>
          </li>
        ))}
      </ol>
      <div style="margin-top:38px">
        <a class="btn btn-marine" href="/prestations">Voir toutes les prestations →</a>
      </div>
    </div>
  </section>

  <div class="rule-wave" aria-hidden="true"></div>

  <!-- ============ CTA FINAL ============ -->
  <section class="cta-final">
    <div class="wrap center">
      <h2 class="h-lg" style="color:#fff;max-width:16ch;margin:0 auto 14px">
        Envie de nous découvrir&nbsp;?
      </h2>
      <p style="color:#ffe3d4;max-width:50ch;margin:0 auto 26px">
        Écoutez nos refrains, venez nous voir jouer près de chez vous, et suivez la vie du groupe.
      </p>
      <div class="cta-actions">
        <a class="btn cta-btn" href="/#extraits">Nous écouter</a>
        <a class="btn cta-ghost" href="/contact">Nous contacter</a>
      </div>
    </div>
  </section>

</Base>

<script>
  // Vidéo du hero : respecte « animations réduites », sinon force la lecture au mieux (mobile inclus).
  document.querySelectorAll('video.hero-video').forEach((v) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.pause();
      return;
    }
    v.muted = true; // requis pour l'autoplay sur mobile
    const tryPlay = () => { const p = v.play(); if (p) p.catch(() => {}); };
    tryPlay();
    v.addEventListener('loadeddata', tryPlay, { once: true });
    // Filet de sécurité : si l'autoplay est bloqué, on relance au 1er geste de l'utilisateur.
    const onInteract = () => {
      tryPlay();
      window.removeEventListener('touchstart', onInteract);
      window.removeEventListener('scroll', onInteract);
      window.removeEventListener('click', onInteract);
    };
    window.addEventListener('touchstart', onInteract, { passive: true });
    window.addEventListener('scroll', onInteract, { passive: true });
    window.addEventListener('click', onInteract);
  });

  // Vidéo de présentation : se lance sans le son quand elle arrive à l'écran, s'arrête quand on la quitte.
  // Le bouton remet la vidéo au début avec le son.
  const pres = document.querySelector('video.pres-player');
  const presBtn = document.querySelector('.pres-sound');
  if (pres && presBtn) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      pres.controls = true;
      presBtn.hidden = true;
    } else {
      new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) { const p = pres.play(); if (p) p.catch(() => {}); }
          else pres.pause();
        });
      }, { threshold: 0.4 }).observe(pres);
      const toggle = () => {
        const on = pres.muted;
        if (on) pres.currentTime = 0;
        pres.muted = !on;
        const p = pres.play(); if (p) p.catch(() => {});
        presBtn.textContent = on ? 'Couper le son' : 'Activer le son';
        presBtn.setAttribute('aria-pressed', String(on));
      };
      presBtn.addEventListener('click', toggle);
      pres.addEventListener('click', toggle);
    }
  }

  // Galerie : flèches et glisser à la souris (la molette verticale ne fait pas défiler une liste horizontale).
  const car = document.querySelector('.gal-carousel');
  let dragged = false;
  if (car) {
    // Barre à roue : un tour complet = environ 7 photos. La barre et la corde suivent aussi le défilement au doigt.
    const helm = document.querySelector('.helm');
    const rot = helm?.querySelector('.helm-rot');
    const PX_PER_DEG = 2100 / 360;
    const rope = document.querySelector('.rope');
    let turning = false, lastA = 0;
    const max = () => car.scrollWidth - car.clientWidth;

    // Une seule corde, modélisée point par point (aucune image, aucun masque) :
    // on calcule tout son tracé (bord gauche -> barre -> nœud -> bout libre), puis on ne dessine
    // que la longueur déroulée selon l'avancement dans les photos. Le bout avance donc réellement,
    // fait le tour de la boucle et se noue sous les yeux ; en revenant, il se dénoue et recule.
    const NS = 'http://www.w3.org/2000/svg';
    const WAVE = 16, WAVELEN = 230;
    const mk = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); parent.appendChild(e); return e; };
    const ROPE = { outline: { stroke: '#241A12', 'stroke-width': 15 }, body: { stroke: '#D6A15E', 'stroke-width': 10 }, twist: { stroke: '#8A5A2B', 'stroke-width': 10, 'stroke-dasharray': '3 7' } };
    const layer = (g, cap) => Object.fromEntries(Object.entries(ROPE).map(([k, at]) =>
      [k, mk('path', { fill: 'none', 'stroke-linecap': cap, 'stroke-linejoin': 'round', ...at }, g)]));
    let rp = null;
    if (rope) {
      const main = mk('g', {}, rope);
      rp = { main: layer(main, 'round'), overs: [0, 1, 2].map(() => layer(mk('g', {}, rope), 'butt')),
        whip: mk('rect', { width: 9, height: 17, x: -4.5, y: -8.5, rx: 2, fill: '#C24E2C', stroke: '#241A12', 'stroke-width': 2.5 }, rope) };
    }
    // points d'une courbe de Bézier cubique
    const bez = (P0, P1, P2, P3, n, out) => {
      for (let i = 1; i <= n; i++) {
        const t = i / n, u = 1 - t;
        out.push([u*u*u*P0[0] + 3*u*u*t*P1[0] + 3*u*t*t*P2[0] + t*t*t*P3[0], u*u*u*P0[1] + 3*u*u*t*P1[1] + 3*u*t*t*P2[1] + t*t*t*P3[1]]);
      }
    };
    const toD = (pts) => pts.map((q, i) => (i ? 'L' : 'M') + q[0].toFixed(1) + ' ' + q[1].toFixed(1)).join(' ');
    function drawRope() {
      if (!rp || !helm) return;
      const W = rope.clientWidth, H = rope.clientHeight, cy = H / 2 + 6;
      rope.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const prog = max() > 0 ? Math.min(1, car.scrollLeft / max()) : 0;
      const phase = car.scrollLeft / 90;
      const xHub = W / 2;
      const xKnot = W * 0.66, r = Math.min(42, W * 0.03), xEnd = Math.min(W - 30, xKnot + r * 5.5);
      // 1) tracé complet
      const pts = [];
      const x0 = -10;
      for (let x = x0; x <= xKnot; x += 6) {
        const u = (x - x0) / (xKnot - x0);
        const env = Math.sin(Math.PI * u) * Math.min(1, Math.abs(x - xHub) / 60);
        pts.push([x, cy + WAVE * env * Math.sin(((x - x0) / WAVELEN) * Math.PI * 2 - phase)]);
      }
      const K = [xKnot, cy];
      const knotStart = pts.length;
      // boucle sous la corde, retour qui croise le brin d'arrivée, puis sortie vers le bout libre
      bez(K, [K[0] + r * 1.5, K[1]], [K[0] + r * 1.5, K[1] + r * 2], [K[0], K[1] + r * 2], 24, pts);
      bez(pts[pts.length - 1], [K[0] - r * 1.6, K[1] + r * 2], [K[0] - r * 1.4, K[1] - r * 0.6], [K[0] + r * 0.3, K[1] - r * 0.5], 24, pts);
      bez(pts[pts.length - 1], [K[0] + r * 1.4, K[1] - r * 0.45], [K[0] + r * 1.7, K[1] + r * 0.4], [K[0] + r * 2.6, K[1] + r * 0.5], 16, pts);
      const last = pts[pts.length - 1];
      for (let x = last[0] + 6; x <= xEnd; x += 6) {
        const u = (x - last[0]) / (xEnd - last[0]);
        pts.push([x, last[1] + 5 * Math.sin(u * Math.PI)]);
      }
      // longueurs cumulées
      const L = [0];
      for (let i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
      const total = L[L.length - 1];
      let iHub = pts.findIndex((q) => q[0] >= xHub + 12); if (iHub < 0) iHub = 0;
      // 2) longueur déroulée : jusqu'à la barre au départ, jusqu'au bout libre à la fin
      const vis = L[iHub] + (total - L[iHub]) * prog;
      const shown = [];
      for (let i = 0; i < pts.length; i++) {
        if (L[i] <= vis) { shown.push(pts[i]); continue; }
        const f = (vis - L[i - 1]) / (L[i] - L[i - 1]);
        shown.push([pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * f, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * f]);
        break;
      }
      const d = toD(shown);
      const off = String(-car.scrollLeft * 0.6);
      for (const k of ['outline', 'body', 'twist']) rp.main[k].setAttribute('d', d);
      rp.main.twist.setAttribute('stroke-dashoffset', off);
      // 3) croisements : le brin qui repasse est redessiné par-dessus (dessus / dessous du nœud)
      const crossings = [];
      if (shown.length > knotStart + 30) {
        for (let j = knotStart + 30; j < shown.length && crossings.length < 3; j++) {
          for (let i = Math.max(0, knotStart - 40); i < j - 25; i++) {
            if (Math.hypot(shown[j][0] - shown[i][0], shown[j][1] - shown[i][1]) < 5) { crossings.push(j); j += 10; break; }
          }
        }
      }
      rp.overs.forEach((ov, n) => {
        const j = crossings[n];
        const on = j !== undefined;
        if (on) {
          const st = Math.max(0, j - 4);
          const dd = toD(shown.slice(st, Math.min(shown.length, j + 5)));
          for (const k of ['outline', 'body', 'twist']) ov[k].setAttribute('d', dd);
          // même motif de torsade que la corde à cet endroit : raccord invisible
          ov.twist.setAttribute('stroke-dashoffset', String(-car.scrollLeft * 0.6 + L[st]));
        }
        for (const k of ['outline', 'body', 'twist']) ov[k].style.visibility = on ? 'visible' : 'hidden';
      });
      // 4) le bout de la corde : une ligature terracotta qui suit sa direction
      const tip = shown[shown.length - 1], prev = shown[Math.max(0, shown.length - 3)];
      const ang = Math.atan2(tip[1] - prev[1], tip[0] - prev[0]) * 180 / Math.PI;
      rp.whip.setAttribute('transform', `translate(${tip[0]} ${tip[1]}) rotate(${ang}) translate(-6 0)`);
      rp.whip.style.visibility = shown.length > iHub ? 'visible' : 'hidden';
    }
    addEventListener('resize', drawRope);
    requestAnimationFrame(drawRope);
    const sync = () => {
      if (!rot) return;
      rot.style.transform = `rotate(${car.scrollLeft / PX_PER_DEG}deg)`;
      drawRope();
      const pct = max() > 0 ? Math.round((car.scrollLeft / max()) * 100) : 0;
      helm.setAttribute('aria-valuenow', String(pct));
      helm.setAttribute('aria-valuetext', pct <= 0 ? 'Début de la galerie' : pct >= 100 ? 'Fin de la galerie' : `Photos à ${pct} %`);
    };
    car.addEventListener('scroll', sync, { passive: true });
    if (helm) {
      const angle = (e) => { const r = helm.getBoundingClientRect(); return Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180 / Math.PI; };
      helm.addEventListener('pointerdown', (e) => {
        turning = true; lastA = angle(e); helm.setPointerCapture(e.pointerId);
        helm.classList.add('turning'); car.classList.add('steering');
      });
      helm.addEventListener('pointermove', (e) => {
        if (!turning) return;
        const a = angle(e); let d = a - lastA;
        if (d > 180) d -= 360; if (d < -180) d += 360;
        lastA = a;
        car.scrollLeft = Math.min(max(), Math.max(0, car.scrollLeft + d * PX_PER_DEG));
        sync();
      });
      const stop = () => { turning = false; helm.classList.remove('turning'); car.classList.remove('steering'); };
      helm.addEventListener('pointerup', stop);
      helm.addEventListener('pointercancel', stop);
      // au clavier : flèches = un huitième de tour, Début / Fin
      helm.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowUp') car.scrollBy({ left: 45 * PX_PER_DEG * 2, behavior: 'smooth' });
        else if (k === 'ArrowLeft' || k === 'ArrowDown') car.scrollBy({ left: -45 * PX_PER_DEG * 2, behavior: 'smooth' });
        else if (k === 'Home') car.scrollTo({ left: 0, behavior: 'smooth' });
        else if (k === 'End') car.scrollTo({ left: max(), behavior: 'smooth' });
        else return;
        e.preventDefault();
      });
    }
    let down = false, x0 = 0, s0 = 0;
    car.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; dragged = false; x0 = e.clientX; s0 = car.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 6) { dragged = true; car.classList.add('dragging'); }
      if (dragged) car.scrollLeft = s0 - dx;
    });
    window.addEventListener('pointerup', () => { down = false; car.classList.remove('dragging'); });
    // un glissé ne doit pas ouvrir la photo
    car.addEventListener('click', (e) => { if (dragged) { e.stopPropagation(); e.preventDefault(); dragged = false; } }, true);
  }

  // Galerie : lightbox au clic (navigation clavier + boutons).
  const lb = document.getElementById('lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.lb-img');
    const thumbs = [...document.querySelectorAll('.gal-thumb')];
    const srcs = thumbs.map((t) => t.dataset.full);
    let cur = 0;
    const show = () => { lbImg.src = srcs[cur]; };
    const open = (i) => { cur = i; show(); lb.hidden = false; document.body.style.overflow = 'hidden'; lb.querySelector('.lb-close').focus(); };
    const close = () => { lb.hidden = true; lbImg.src = ''; document.body.style.overflow = ''; thumbs[cur]?.focus(); };
    const nav = (d) => { cur = (cur + d + srcs.length) % srcs.length; show(); };
    thumbs.forEach((t, i) => t.addEventListener('click', () => open(i)));
    lb.querySelector('.lb-close').addEventListener('click', close);
    lb.querySelector('.lb-prev').addEventListener('click', () => nav(-1));
    lb.querySelector('.lb-next').addEventListener('click', () => nav(1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    });
  }
</script>

<style>
