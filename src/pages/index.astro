  .gal-carousel.dragging .gal-thumb{pointer-events:none}
  .gal-thumb img{-webkit-user-drag:none;user-select:none}
  /* barre à roue : 30 % posée sur les photos, 70 % dessous */
  .helm-wrap{--helm:190px;display:flex;justify-content:center;position:relative;z-index:3;isolation:isolate;
    margin-top:calc(var(--helm) * -.3 - 20px);pointer-events:none}
  /* corde tressée qui traverse l'écran derrière la barre et défile avec les photos */
  .rope{position:absolute;top:50%;left:50%;width:100vw;height:240px;transform:translate(-50%,-50%);z-index:-1;
    overflow:visible;pointer-events:none;filter:drop-shadow(0 4px 0 rgba(36,26,18,.18))}
  .helm{width:var(--helm);height:var(--helm);border-radius:50%;cursor:grab;touch-action:none;pointer-events:auto;
    filter:drop-shadow(6px 6px 0 var(--encre))}
  .helm.turning{cursor:grabbing}
  .helm:focus-visible{outline:3px solid var(--terracotta);outline-offset:6px}
  .helm-svg{width:100%;height:100%;display:block;overflow:visible}
  .helm-rot{transform-box:fill-box;transform-origin:center;transition:transform .08s linear}
  .helm.turning .helm-rot{transition:none}
  .gal-carousel.steering{scroll-snap-type:none}
  @media(hover:hover){.helm:hover .helm-rot{transform-origin:center}}
