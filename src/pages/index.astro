  .hero-badge strong{font-family:var(--serif);font-weight:900;font-size:2rem;line-height:1;color:var(--orange)}
  .hero-badge span{font-size:.8rem;max-width:12ch;line-height:1.3;color:#dbe8ee}

  /* VIDÉO DE PRÉSENTATION */
