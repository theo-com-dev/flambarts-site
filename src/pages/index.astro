---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const instruments = ['Accordéon diatonique', 'Accordéon chromatique', 'Guitare', 'Basse', 'Cajon', '2 voix'];
const extraits = [
  { titre: 'Le vieux', src: '/audio/le-vieux.mp3' },
  { titre: '15 marins', src: '/audio/15-marins.mp3' },
];
const agenda = [
  { j: '15', m: 'AOÛT', quand: 'Samedi · 18h00', lieu: 'Fête du Port', ville: 'Le Croisic (44)', info: 'Entrée libre' },
  { j: '21', m: 'AOÛT', quand: 'Vendredi · 20h30', lieu: 'Festival Chants de Marins', ville: 'Paimpol (22)', info: 'Billetterie' },
  { j: '05', m: 'SEPT', quand: 'Samedi · 17h00', lieu: 'Fête de la Mer', ville: 'La Turballe (44)', info: 'Entrée libre' },
];
const prestations = [
  { ico: 'glass', titre: 'Restaurants & bars', txt: "On passe entre les tables et on chante, sans couvrir les conversations. Vos clients restent, et ils reviennent." },
  { ico: 'building', titre: "Événements d'entreprise", txt: "Séminaires, inaugurations, soirées clients. Un moment qui change des discours et fait chanter les équipes." },
  { ico: 'bunting', titre: 'Fêtes locales & maritimes', txt: "Fêtes de la musique, courses à la voile, 14 juillet. Sur scène, avec le répertoire qui fait lever la foule." },
];
// Galerie automatique : dépose des images dans src/assets/galerie/ et elles apparaissent ici.
const galModules = import.meta.glob('../assets/galerie/*.{jpg,jpeg,png,webp}', { eager: true });
const galerie = Object.entries(galModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);
---
<Base active="accueil">

  <!-- ============ HERO (scène animée) ============ -->
  <section class="hero">
    <div class="hero-scene" aria-hidden="true">
      <video class="hero-video" autoplay muted loop playsinline webkit-playsinline preload="auto" poster="/hero-poster.jpg">
        <source src="/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="wrap hero-in">
      <div class="hero-copy">
        <span class="kicker">Groupe de chants marins · Bretagne</span>
        <h1 class="h-xl">Chants marins <span class="amp">&amp;</span> ambiance bord de mer</h1>
        <p class="lead">
          Sept musiciens d'Herbignac qui reprennent les grands chants de marins, de « Santiano »
          à « Nous irons à Valparaiso ». Des refrains que toute la salle finit par chanter avec nous.
        </p>
        <div class="instr">
          <span class="instr-label">À l'oreille :</span>
          {instruments.map((i) => <span class="chip">{i}</span>)}
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#extraits">▶ Nous écouter</a>
          <a class="btn btn-ghost" href="#agenda">Nos prochaines dates</a>
        </div>
      </div>
    </div>

    <div class="hero-badge"><strong>7</strong><span>musiciens · 100 % bonne humeur</span></div>
  </section>

  <!-- ============ GALERIE PHOTO ============ -->
  <section class="pad-sm gallery" id="galerie">
    <div class="wrap">
      <div class="section-head center">
        <span class="kicker">En images</span>
        <h2 class="h-lg">Le groupe en photos</h2>
        <p class="lead" style="margin:12px auto 0">
          Faites défiler, et cliquez sur une photo pour la voir en grand.
        </p>
      </div>
    </div>
    <div class="gal-carousel" role="region" aria-label="Photos des Flambarts">
      {galerie.map((p, i) => (
        <button class="gal-thumb" data-full={p.src} type="button" aria-label={`Agrandir la photo ${i + 1} sur ${galerie.length}`}>
          <img src={p.src} width={p.width} height={p.height} alt="Les Flambarts en concert" loading="lazy" />
        </button>
      ))}
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-close" type="button" aria-label="Fermer">✕</button>
    <button class="lb-prev" type="button" aria-label="Photo précédente">‹</button>
    <img class="lb-img" src="" alt="Les Flambarts en concert" />
    <button class="lb-next" type="button" aria-label="Photo suivante">›</button>
  </div>

  <!-- ============ EXTRAITS AUDIO ============ -->
  <section class="pad" id="extraits">
    <div class="wrap">
      <div class="section-head center">
        <span class="kicker">À écouter</span>
        <h2 class="h-lg">Notre musique</h2>
        <p class="lead" style="margin:12px auto 0">
          Deux morceaux à écouter tout de suite. Montez le son.
        </p>
      </div>
      <div class="grid grid-2">
        {extraits.map((e) => (
          <div class="track">
            <div class="track-t serif">{e.titre}</div>
            <audio controls preload="none" src={e.src}></audio>
          </div>
        ))}
      </div>
      <p class="note">D'autres morceaux seront ajoutés au fil du temps.</p>
    </div>
  </section>

  <!-- ============ CONCEPT ============ -->
  <section class="pad concept">
    <div class="wrap grid grid-2 concept-in">
      <div>
        <span class="kicker">Le nom</span>
        <h2 class="h-lg" style="margin:14px 0 16px">D'où vient « Les Flambarts »</h2>
        <p class="lead" style="color:#d9e4ea">
          Un flambart, c'est une vieille chaloupe de pêche. Le mot sonne aussi comme la flamme
          et l'entrain, et ça nous va bien. On chante le répertoire des marins, ces refrains que
          le public reprend en chœur. On joue aussi bien entre les tables que sur une vraie scène,
          et on vient avec notre matériel.
        </p>
        <a class="btn btn-primary" style="margin-top:24px" href="/le-groupe">Rencontrer le groupe →</a>
      </div>
      <div class="card concept-card">
        <div class="flame"><Icon name="flame" size={38} /></div>
        <h3 class="serif" style="font-size:1.4rem;margin-bottom:10px">En un mot</h3>
        <p style="color:#cfe0e8">
          On joue pour de vrai, sans se prendre au sérieux. Le but tient en une phrase : que la
          salle chante avec nous et reparte de bonne humeur.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ AGENDA ============ -->
  <section class="pad" id="agenda">
    <div class="wrap">
      <div class="head-row">
        <div><span class="kicker">Agenda</span><h2 class="h-lg" style="margin-top:12px">Où nous voir bientôt</h2></div>
        <a class="btn btn-ghost" href="/actualites">Toutes les dates →</a>
      </div>
      <div class="grid grid-3">
        {agenda.map((d) => (
          <div class="date card">
            <div class="date-badge"><strong>{d.j}</strong><span>{d.m}</span></div>
            <div>
              <div class="date-when">{d.quand}</div>
              <div class="date-lieu serif">{d.lieu}</div>
              <div class="date-ville">{d.ville}</div>
              <span class="date-info">{d.info}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PRESTATIONS ============ -->
  <section class="pad prestations">
    <div class="wrap">
      <div class="section-head center">
        <span class="kicker">Nos prestations</span>
        <h2 class="h-lg">Ce qu'on fait</h2>
      </div>
      <div class="grid grid-3">
        {prestations.map((p) => (
          <div class="card presta">
            <div class="presta-ico"><Icon name={p.ico} /></div>
            <h3 class="serif" style="font-size:1.35rem;margin-bottom:10px">{p.titre}</h3>
            <p style="color:var(--encre-soft)">{p.txt}</p>
          </div>
        ))}
      </div>
      <div class="center" style="margin-top:34px">
        <a class="btn btn-marine" href="/prestations">Voir toutes les prestations →</a>
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  <section class="cta-final">
    <div class="wrap center">
      <h2 class="h-lg" style="color:#fff;max-width:16ch;margin:0 auto 14px">
        Envie de nous découvrir&nbsp;?
      </h2>
      <p style="color:#ffe3d4;max-width:50ch;margin:0 auto 26px">
        Écoutez nos refrains, venez nous voir jouer près de chez vous, et suivez la vie du groupe.
      </p>
      <div class="cta-actions">
        <a class="btn cta-btn" href="/#extraits">Nous écouter</a>
        <a class="btn cta-ghost" href="/contact">Nous contacter</a>
      </div>
    </div>
  </section>

</Base>

<script>
  // Vidéo du hero : respecte « animations réduites », sinon force la lecture au mieux (mobile inclus).
  document.querySelectorAll('video.hero-video').forEach((v) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.pause();
      return;
    }
    v.muted = true; // requis pour l'autoplay sur mobile
    const tryPlay = () => { const p = v.play(); if (p) p.catch(() => {}); };
    tryPlay();
    v.addEventListener('loadeddata', tryPlay, { once: true });
    // Filet de sécurité : si l'autoplay est bloqué, on relance au 1er geste de l'utilisateur.
    const onInteract = () => {
      tryPlay();
      window.removeEventListener('touchstart', onInteract);
      window.removeEventListener('scroll', onInteract);
      window.removeEventListener('click', onInteract);
    };
    window.addEventListener('touchstart', onInteract, { passive: true });
    window.addEventListener('scroll', onInteract, { passive: true });
    window.addEventListener('click', onInteract);
  });

  // Galerie : lightbox au clic (navigation clavier + boutons).
  const lb = document.getElementById('lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.lb-img');
    const thumbs = [...document.querySelectorAll('.gal-thumb')];
    const srcs = thumbs.map((t) => t.dataset.full);
    let cur = 0;
    const show = () => { lbImg.src = srcs[cur]; };
    const open = (i) => { cur = i; show(); lb.hidden = false; document.body.style.overflow = 'hidden'; lb.querySelector('.lb-close').focus(); };
    const close = () => { lb.hidden = true; lbImg.src = ''; document.body.style.overflow = ''; thumbs[cur]?.focus(); };
    const nav = (d) => { cur = (cur + d + srcs.length) % srcs.length; show(); };
    thumbs.forEach((t, i) => t.addEventListener('click', () => open(i)));
    lb.querySelector('.lb-close').addEventListener('click', close);
    lb.querySelector('.lb-prev').addEventListener('click', () => nav(-1));
    lb.querySelector('.lb-next').addEventListener('click', () => nav(1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    });
  }
</script>

<style>
  /* HERO + VIDÉO */
  .hero{position:relative;overflow:hidden;background:var(--marine-d);min-height:min(90vh,760px);display:flex;align-items:center}
  .hero-scene{position:absolute;inset:0;z-index:0}
  .hero-video{width:100%;height:100%;object-fit:cover;display:block}
  .hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(100deg,rgba(251,246,236,.98) 0%,rgba(251,246,236,.92) 34%,rgba(251,246,236,.55) 52%,rgba(251,246,236,0) 74%)}
  .hero-in{position:relative;z-index:2;width:100%;padding-top:40px;padding-bottom:84px}
  .hero-copy{max-width:600px}
  .hero-copy h1{margin:16px 0 20px}
  .amp{color:var(--terracotta);font-style:italic}
  .instr{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin:22px 0 28px}
  .instr-label{font-weight:700;font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;color:var(--encre-soft)}
  .chip{background:rgba(255,255,255,.9);border:1px solid rgba(42,32,24,.12);border-radius:999px;padding:6px 14px;font-size:.85rem;font-weight:600;box-shadow:0 2px 8px -6px rgba(42,32,24,.3)}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .hero-badge{position:absolute;z-index:2;bottom:24px;right:26px;background:var(--marine);color:#fff;border-radius:16px;padding:14px 20px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow)}
  .hero-badge strong{font-family:var(--serif);font-size:2rem;line-height:1;color:var(--orange)}
  .hero-badge span{font-size:.8rem;max-width:12ch;line-height:1.3;color:#dbe8ee}

  /* GALERIE — carrousel horizontal */
  .gallery{background:var(--creme-2);overflow:hidden}
  .gal-carousel{display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;
    padding:6px max(26px,calc((100% - var(--maxw))/2 + 26px)) 20px;
    scrollbar-width:thin;scrollbar-color:var(--terracotta) transparent;-webkit-overflow-scrolling:touch}
  .gal-carousel::-webkit-scrollbar{height:8px}
  .gal-carousel::-webkit-scrollbar-thumb{background:var(--terracotta);border-radius:999px}
  .gal-thumb{flex:0 0 auto;width:280px;height:280px;padding:0;border:0;border-radius:16px;overflow:hidden;
    cursor:pointer;scroll-snap-align:center;background:var(--placeholder);box-shadow:var(--shadow-sm);
    transition:transform .2s ease}
  .gal-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .gal-thumb:hover{transform:translateY(-3px)}
  .gal-thumb:focus-visible{outline:3px solid var(--terracotta);outline-offset:3px}
  @media(max-width:640px){
    .gal-carousel{padding-left:16px;padding-right:16px;gap:12px}
    .gal-thumb{width:78vw;height:78vw;max-width:340px;max-height:340px}
  }

  /* LIGHTBOX */
  .lightbox{position:fixed;inset:0;z-index:200;background:rgba(10,20,28,.93);
    display:flex;align-items:center;justify-content:center;padding:24px}
  .lightbox[hidden]{display:none}
  .lb-img{max-width:92vw;max-height:88vh;object-fit:contain;border-radius:6px;box-shadow:0 24px 70px rgba(0,0,0,.55)}
  .lb-close,.lb-prev,.lb-next{position:absolute;background:rgba(255,255,255,.14);color:#fff;border:0;
    border-radius:50%;cursor:pointer;line-height:1;display:flex;align-items:center;justify-content:center;transition:background .15s}
  .lb-close:hover,.lb-prev:hover,.lb-next:hover{background:rgba(255,255,255,.28)}
  .lb-close{top:18px;right:22px;width:46px;height:46px;font-size:1.3rem}
  .lb-prev,.lb-next{top:50%;transform:translateY(-50%);width:54px;height:54px;font-size:2rem}
  .lb-prev{left:18px}
  .lb-next{right:18px}
  @media(max-width:640px){.lb-prev,.lb-next{width:44px;height:44px;font-size:1.6rem}.lb-prev{left:8px}.lb-next{right:8px}}

  @media(max-width:860px){
    .hero{min-height:auto}
    .hero::after{background:linear-gradient(180deg,rgba(251,246,236,.92) 0%,rgba(251,246,236,.6) 42%,rgba(251,246,236,.25) 100%)}
    .hero-in{padding-top:28px;padding-bottom:190px}
    .hero-badge{bottom:16px;right:50%;transform:translateX(50%)}
  }

  /* TRACKS */
  .track{background:#fff;border:1px solid rgba(42,32,24,.07);border-radius:var(--radius);padding:20px 22px;box-shadow:var(--shadow-sm)}
  .track-t{font-size:1.2rem;font-weight:600;margin-bottom:14px}
  .track audio{width:100%;height:44px}
  .note{text-align:center;margin-top:26px;color:var(--encre-soft);font-size:.92rem;background:var(--sable);display:inline-block;padding:10px 20px;border-radius:999px;position:relative;left:50%;transform:translateX(-50%)}

  /* CONCEPT */
  .concept{background:var(--marine);color:#eaf1f4}
  .concept .kicker{color:var(--orange)}
  .concept h2{color:#fff}
  .concept-in{align-items:center}
  .concept-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#eaf1f4}
  .concept-card h3{color:#fff}
  .flame{color:var(--orange);margin-bottom:10px}

  /* AGENDA */
  .head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:34px;flex-wrap:wrap}
  .date{display:flex;gap:18px;align-items:center}
  .date-badge{flex:0 0 auto;width:64px;height:64px;border-radius:14px;background:var(--terracotta);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
  .date-badge strong{font-family:var(--serif);font-size:1.5rem}
  .date-badge span{font-size:.7rem;letter-spacing:.08em;margin-top:2px}
  .date-when{font-size:.82rem;color:var(--encre-soft);font-weight:600}
  .date-lieu{font-size:1.15rem;margin:2px 0}
  .date-ville{font-size:.9rem;color:var(--encre-soft)}
  .date-info{display:inline-block;margin-top:8px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--iode);background:rgba(28,110,126,.1);padding:3px 10px;border-radius:999px}

  /* PRESTATIONS */
  .prestations{background:var(--creme-2)}
  .presta-ico{width:58px;height:58px;border-radius:14px;background:var(--sable);color:var(--terracotta);
    display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .presta{transition:transform .18s,box-shadow .2s}
  .presta:hover{transform:translateY(-4px);box-shadow:var(--shadow)}

  /* CTA FINAL */
  .cta-final{background:linear-gradient(135deg,var(--terracotta),var(--terracotta-d));padding:clamp(56px,8vw,96px) 0}
  .cta-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .cta-btn{background:#fff;color:var(--terracotta);font-size:1.05rem;padding:16px 32px}
  .cta-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
  .cta-ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.55);font-size:1.05rem;padding:16px 32px}
  .cta-ghost:hover{background:rgba(255,255,255,.12);transform:translateY(-2px)}
</style>
