    display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:900}
  /* vidéo à gauche, texte à droite (vidéo au-dessus du texte sur téléphone) */
  .pres-video{order:-1;position:relative;justify-self:center;width:min(100%,330px);aspect-ratio:9/16;margin:0;
    border:2px solid var(--encre);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--hard);background:var(--creme-2)}
