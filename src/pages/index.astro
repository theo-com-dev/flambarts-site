    border:2px solid var(--encre);box-shadow:var(--hard-sm);
    display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
  .date-badge strong{font-family:var(--serif);font-weight:900;font-size:1.5rem}
