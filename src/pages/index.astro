  .gal-carousel::-webkit-scrollbar-thumb{background:var(--terracotta);border-radius:999px}
  .gal-thumb{flex:0 0 auto;width:280px;height:280px;padding:0;border:2px solid var(--encre);border-radius:var(--r);overflow:hidden;
    cursor:pointer;scroll-snap-align:center;background:var(--placeholder);
    transition:transform .18s ease, box-shadow .18s ease}
  .gal-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .gal-thumb:hover{transform:translate(-3px,-3px);box-shadow:var(--hard-sm)}
  .gal-thumb:focus-visible{outline:3px solid var(--terracotta);outline-offset:3px}
  @media(max-width:640px){
    .gal-carousel{padding-left:16px;padding-right:16px;gap:12px}
    .gal-thumb{width:78vw;height:78vw;max-width:340px;max-height:340px}
  }

  /* LIGHTBOX */
  .lightbox{position:fixed;inset:0;z-index:200;background:rgba(10,20,28,.93);
    display:flex;align-items:center;justify-content:center;padding:24px}
  .lightbox[hidden]{display:none}
  .lb-img{max-width:92vw;max-height:88vh;object-fit:contain;border-radius:6px;box-shadow:0 24px 70px rgba(0,0,0,.55)}
  .lb-close,.lb-prev,.lb-next{position:absolute;background:rgba(255,255,255,.14);color:#fff;border:0;
    border-radius:50%;cursor:pointer;line-height:1;display:flex;align-items:center;justify-content:center;transition:background .15s}
  .lb-close:hover,.lb-prev:hover,.lb-next:hover{background:rgba(255,255,255,.28)}
  .lb-close{top:18px;right:22px;width:46px;height:46px;font-size:1.3rem}
  .lb-prev,.lb-next{top:50%;transform:translateY(-50%);width:54px;height:54px;font-size:2rem}
  .lb-prev{left:18px}
  .lb-next{right:18px}
  @media(max-width:640px){.lb-prev,.lb-next{width:44px;height:44px;font-size:1.6rem}.lb-prev{left:8px}.lb-next{right:8px}}

  @media(max-width:860px){
    .hero{min-height:auto}
    .hero-video{object-position:85% 50%}
    .hero::after{background:linear-gradient(180deg,rgba(251,246,236,.92) 0%,rgba(251,246,236,.6) 42%,rgba(251,246,236,.25) 100%)}
    .hero-in{padding-top:28px;padding-bottom:190px}
    .hero-badge{bottom:16px;right:50%;transform:translateX(50%)}
  }

  /* TRACKS */
  .track{background:var(--creme);border:2px solid var(--encre);border-radius:var(--r);padding:20px 22px}
  .track-t{font-size:1.25rem;font-weight:600;margin-bottom:14px}
  .track audio{width:100%;height:44px}
  .note{text-align:center;margin-top:26px;color:var(--encre-soft);font-size:.92rem;
    display:block;font-style:italic}

  /* CONCEPT */
  .concept{background:var(--marine);color:#eaf1f4}
  .concept .kicker{color:var(--orange)}
  .concept .kicker::before{background:var(--orange)}
  .concept h2{color:#fff}
  .concept-in{align-items:center}
  .concept-card{background:transparent;border:2px solid rgba(255,255,255,.35);border-radius:var(--r);color:#eaf1f4;padding:28px}
  .concept-card h3{color:#fff}
  .flame{color:var(--orange);margin-bottom:10px}

  /* AGENDA — lignes éditoriales à filets */
  .agenda-vide{border-top:2px solid var(--encre);padding:26px 0 6px;font-size:1.08rem;color:var(--encre-soft)}
