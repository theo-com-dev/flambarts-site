    .pres-grid{grid-template-columns:1fr;gap:28px}
    .pres-video{width:min(78vw,330px)}
  }

  /* GALERIE — carrousel horizontal */
  .gallery{background:var(--creme-2);overflow:hidden}
  .gal-carousel{display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;
    padding:6px max(26px,calc((100% - var(--maxw))/2 + 26px)) 20px;
    scrollbar-width:thin;scrollbar-color:var(--terracotta) transparent;-webkit-overflow-scrolling:touch}
  .gal-carousel::-webkit-scrollbar{height:8px}
