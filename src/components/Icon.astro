---
// Jeu d'icônes « tracées à l'encre » — trait unique, monde maritime & musical.
// Usage : <Icon name="anchor" /> — hérite de la couleur (currentColor) et se dimensionne au parent.
const { name, size = 34, stroke = 1.7, class: klass = '' } = Astro.props;

const paths: Record<string, string> = {
  // Restaurants & bars — verre + bouteille
  glass: 'M7 4h6l-1 6.5a2 2 0 0 1-4 0L7 4Z M10 12.5V19 M8 19h4 M16 3c1 0 1 1 1 2v5c0 1-.5 1.5-1.5 1.5S14 11 14 10V5c0-1 0-2 1-2Z',
  // Événements d'entreprise — bâtisse
  building: 'M5 20V6l7-3 7 3v14 M4 20h16 M9 9h1.5 M13.5 9H15 M9 12.5h1.5 M13.5 12.5H15 M10.5 20v-3.5h3V20',
  // Fêtes locales & maritimes — guirlande de fanions
  bunting: 'M3 5c6 3.2 12 3.2 18 0 M6 6.2l1.6 3.2L9.2 6 M11 6.6l1.6 3.2L14.2 6.4',
  // Caritatif — bouée de sauvetage
  buoy: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M12 3v2.2 M12 18.8V21 M3 12h2.2 M18.8 12H21',
  // Fêtes privées — fanal / lanterne
  lantern: 'M9.5 3h5 M10 3V2h4v1 M8.5 6.5h7l-.6 10.5H9.1L8.5 6.5Z M12 9.5c1.2 1.3 1.8 2 1.8 3a1.8 1.8 0 0 1-3.6 0c0-.7.4-1.2.9-1.7.2.5.6.7.9.4Z',
  // Rassemblements maritimes — ancre
  anchor: 'M12 3.4a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z M12 7.4V20 M8.5 10.5h7 M5 13a7 7 0 0 0 14 0 M5 13l-1.6 1.4M5 13l1.8.9 M19 13l1.6 1.4M19 13l-1.8.9',
  // Concept « la mer & la flamme »
  flame: 'M12 3c2.6 3.4 4.4 5.2 4.4 8.2a4.4 4.4 0 0 1-8.8 0c0-1.6.7-2.6 1.6-3.6.4 1 1.2 1.4 1.8 1 .2-1.8-.6-2.8 1-5.6Z',
  // « comment ça se passe »
  note: 'M9 17V5l9-1.8V15 M9 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z M18 15a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
  bolt: 'M13 3 5 13h5l-1 8 9-11h-5l1-7Z',
  ruler: 'M3 8.5h18v7H3z M7 8.5v2.5 M11 8.5v3 M15 8.5v2.5 M19 8.5v3',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 7.5v5l3.2 2',
  // Contact
  phone: 'M6.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 5 5l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7 2 2 0 0 1 5.5 3.5Z',
  mail: 'M3.5 6h17v12h-17z M3.5 7l8.5 6 8.5-6',
  pin: 'M12 21s6.5-5.6 6.5-11a6.5 6.5 0 0 0-13 0c0 5.4 6.5 11 6.5 11Z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  megaphone: 'M4 10v4h3l8 4V6l-8 4H4Z M18 9.2a4 4 0 0 1 0 5.6',
};

const d = paths[name] ?? '';
---
<svg class={`ic ${klass}`} width={size} height={size} viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  <path d={d} />
</svg>
<style>
  .ic{display:block;flex:0 0 auto}
</style>
